# Auth.js v5
AUTH_SECRET=               # genera con: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Supabase (backend Postgres + storage). Service role key: NON esporla mai al client.
# Reperibili da: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://aikforfebngrqfzdkowo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Webhook in arrivo da n8n (opzionale, riservato per futura sync push)
N8N_WEBHOOK_SECRET=

# Shared bearer token per `POST /api/revalidate/movimenti`: n8n lo manda nel
# header `Authorization: Bearer <token>` dopo ogni upsert su Supabase per
# invalidare subito la cache `movimenti` di Next.js (altrimenti il sito
# aspetta il TTL di unstable_cache, 5 min). Min 16 char, genera con:
# openssl rand -hex 32
REVALIDATE_TOKEN=

# Upstash Redis per rate limiting /login (5 tentativi / 15 min per coppia IP+email).
# Reperibili da: https://console.upstash.com/redis/<db-id> -> REST API
# Se mancanti, il rate limiting e' disabilitato (fail-open) e in console esce un warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NODE_ENV=development
