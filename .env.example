# Auth.js v5
AUTH_SECRET=               # genera con: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Supabase (backend Postgres + storage). Service role key: NON esporla mai al client.
# Reperibili da: https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://aikforfebngrqfzdkowo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Airtable (DEPRECATA): conservata solo per lo script di migrazione one-off
# (scripts/migrate-airtable-to-supabase.ts). Rimuovere dopo cutover.
AIRTABLE_API_KEY=          # Personal Access Token con scope data.records:r/w
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Webhook in arrivo da n8n (opzionale, riservato per futura sync push)
N8N_WEBHOOK_SECRET=

NODE_ENV=development
